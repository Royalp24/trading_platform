# Application
APP_NAME=Trading Platform API
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Database
POSTGRES_DB=trading_platform
POSTGRES_USER=trading_platform
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://trading_platform:change-me@db:5432/trading_platform

# Authentication (foundation configuration only)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Replaceable providers
MARKET_DATA_PROVIDER=unconfigured
FUNDAMENTAL_DATA_PROVIDER=unconfigured
NEWS_PROVIDER=unconfigured
NOTIFICATION_PROVIDER=unconfigured

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_PROXY_TARGET=http://localhost:8000
