# Market data provider selected by default.
# Supported values: yahoo, nse, upstox, zerodha.
DEFAULT_MARKET_PROVIDER=yahoo

# Network request timeout in seconds for future provider integrations.
REQUEST_TIMEOUT=30

# Cache TTL in seconds for future Yahoo Finance market data responses.
YAHOO_CACHE_TTL=300

# Enables or disables future provider-level caching.
ENABLE_PROVIDER_CACHE=true

# Enables or disables logging of future provider requests.
LOG_PROVIDER_REQUESTS=false

# Default timezone for market data timestamps and scheduling.
DEFAULT_TIMEZONE=Asia/Kolkata
